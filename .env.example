# Telegram Bot credentials
# Create a bot via @BotFather on Telegram, then paste the token here.
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Telegram chat ID of the owner (Misha) where lead notifications will be sent.
# How to get it: message @userinfobot or @get_id_bot on Telegram.
TELEGRAM_OWNER_CHAT_ID=your_chat_id_here
